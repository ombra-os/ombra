[Unit]
Description=Ombra gateway container (Tor, DNS and firewall for the single edition)
# the container takes the VM's only NIC: no NIC, no gateway (and nothing else may claim it first)
Requires=sys-subsystem-net-devices-ombra\x2dnic.device
After=sys-subsystem-net-devices-ombra\x2dnic.device
# never Before=NetworkManager.service: NM is Before=network.target, and that ordering cycle deletes NM's start job
Wants=modprobe@tun.service modprobe@loop.service modprobe@dm_mod.service
After=network.target nftables.service local-fs.target modprobe@tun.service modprobe@loop.service modprobe@dm_mod.service
Before=machines.target
RequiresMountsFor=/var/lib/ombra

[Service]
Type=notify
NotifyAccess=all
ExecStart=/usr/local/sbin/ombra-gateway-run
KillMode=mixed
Delegate=yes
Slice=machine.slice
# exit 133 is a reboot requested from inside the container
SuccessExitStatus=133
RestartForceExitStatus=133
Restart=on-failure
RestartSec=3
TimeoutStartSec=90
# no DevicePolicy=/DeviceAllow=: measured on a real install, any device policy here makes nspawn fail ("Failed to adjust
# UID/GID shift of OS tree: Operation not permitted"), even with block-loop rwm; the run script starts fine without it
# a misbehaving Tor side must not starve the desktop of memory or tasks
MemoryMax=768M
TasksMax=512

[Install]
WantedBy=multi-user.target
