[Unit]
Description=KActivities recording database on volatile tmpfs (nothing persists)
After=home.mount
# kact-wipe verifies, as the user, that the path holds no symlink; systemd also refuses a non-canonical Where= (ELOOP)
Requires=kact-wipe.service
After=kact-wipe.service

[Mount]
What=tmpfs
Where=/home/ombra/.local/share/kactivitymanagerd/resources
Type=tmpfs
Options=mode=0700,uid=1000,gid=1000

[Install]
WantedBy=multi-user.target
