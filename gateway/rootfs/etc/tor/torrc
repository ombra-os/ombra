# Ombra gateway torrc — Tor client; egress permitted only for the
# debian-tor uid (the fail-closed half lives in nftables).

User debian-tor
DataDirectory /var/lib/tor
AvoidDiskWrites 1
SafeLogging 1
Log notice syslog

ClientOnly 1
DirCache 0

# ---- ports for the desktop ----
# SOCKS is the desktop's only way into Tor. There is no TransPort, no DNSPort and no automap: each was a second
# way for the desktop to reach Tor's resolver and address-map code (TROVE-2026-036 lived there), and no shipped
# application used them, because the desktop firewall only ever allowed connections to this gateway.
# general SOCKS for desktop apps: a separate circuit per destination address and port
SocksPort 10.55.10.1:9050 IsolateDestAddr IsolateDestPort
# Tor Browser only: it isolates per site itself (SOCKS credentials per first party), so per-destination
# isolation here would split one page across a circuit per third-party host. Flags as in its own torrc-defaults
SocksPort 10.55.10.1:9150 ExtendedErrors KeepAliveIsolateSOCKSAuth
# only the private link and this machine may speak SOCKS (the firewall says the same)
SocksPolicy accept 10.55.10.0/24
SocksPolicy accept 127.0.0.1
SocksPolicy reject *

# Tor never starts another program (no pluggable transports ship); the service sandbox says the same
NoExec 1

# gateway-local SOCKS for the leak-test harness
SocksPort 127.0.0.1:9050

# loopback-only control port: ombra-torctl-filter is the only client
# (and the only intnet listener); cookie auth gates the filter itself
ControlPort 127.0.0.1:9051
CookieAuthentication 1
# the filter's upstream cookie: group-readable by debian-tor, whose only
# member is the filter service (SupplementaryGroups, not /etc/group)
CookieAuthFile /run/tor/control.authcookie
CookieAuthFileGroupReadable 1
# Debian's tor-service-defaults arms a GroupWritable ControlSocket; no unix
# control socket exists at all, so there is no side door to the control port
ControlSocket 0

# an idle gateway must never doze on the desktop (the consensus fetch
# stall would read as a dead link)
DormantTimeoutEnabled 0
