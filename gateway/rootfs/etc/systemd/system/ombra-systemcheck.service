[Unit]
# Console face: ombra-splash on tty1. Nothing starts it automatically (no
# [Install], no timer, no login hook): `sudo systemctl start
# ombra-systemcheck.service` on demand. Detailed report: sudo ombra-systemcheck.
Description=Ombra gateway console splash (boot health verdict)

[Service]
Type=oneshot
# keeps is-active "active" after a green splash
RemainAfterExit=yes
# the splash opens /dev/tty1 itself; the check engine setpriv-drops and
# renders nftables in a netns — setuid caps + AF_NETLINK must survive
ExecStart=/usr/local/sbin/ombra-splash --boot
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
# worst case: 150s Tor wait + 65s resolve + 18s onion + 120s SOCKS + 8s egress
TimeoutStartSec=420
